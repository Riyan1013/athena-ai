{
  "name": "athena-ai",
  "version": "0.1.0",
  "description": "Athena AI - The Goddess of AI Wisdom",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "lint": "echo \"Linting will be added later\"",
    "format": "echo \"Formatting will be added later\"",
    "db:generate": "prisma generate",
    "db:verify-connection": "tsx src/memory/postgres/verifyConnection.ts",
    "db:verify-schema": "tsx src/memory/postgres/verifyMemoriesTable.ts",
    "db:test:postgres-repository": "tsx src/tests/PostgresMemoryRepositoryTest.ts"
  },
  "keywords": [
    "ai",
    "assistant",
    "typescript",
    "discord",
    "athena"
  ],
  "author": "Riyan Pinjar",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/pg": "^8.23.1",
    "prisma": "7.10.0",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@google/genai": "^2.16.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  }
}
